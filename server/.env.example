# Server
PORT=8787

# Scraping — runs HEADLESS by default (the browser never opens). Set HEADFUL=true
# only to watch/debug a run locally.
HEADFUL=false
SLOW_MO_MS=0

# Harvest target — the scraper keeps going until it collects this many unique
# businesses OR genuinely runs out of ads while scrolling.
TARGET_ADS=5000

# Robustness knobs
MAX_RUN_MS=5400000            # safety ceiling for a whole harvest, all keywords (90 min)
SCROLL_SETTLE_MS=2200         # pause after every scroll so the next feed page loads
STABLE_SCROLLS_TO_STOP=5      # stop after N scrolls with zero new ads (feed exhausted)
NO_NEW_ADS_GRACE_MS=7000      # extra wait+recheck before counting a scroll as empty
ENRICH_CONCURRENCY=3          # parallel pages for contact / owner enrichment

# ── Owner enrichment ────────────────────────────────────────────────────────
# The automatic owner phase: Hunter.io -> search engines -> company website.
OWNER_ENRICH=true
OWNER_SEARCH_ENABLED=true     # the search-engine fallback

# Hunter.io — the primary owner source. Get a key at hunter.io/api-keys.
# Without a key the app still works; owners come from search + website only.
HUNTER_API_KEY=
HUNTER_ENABLED=true

# Credit guards. Paid Hunter calls only happen for a domain the FREE email-count
# endpoint says has an executive, are capped per run, and never drain the
# account below the reserve. Answers are cached in SQLite for CACHE_DAYS so the
# same domain is never paid for twice.
HUNTER_MAX_CREDITS_PER_RUN=100
HUNTER_MIN_CREDITS_RESERVE=10
HUNTER_CACHE_DAYS=30

# Local database (SQLite). Stores every seen ad + kept business so re-searches
# skip what you already have.
# DB_PATH=./data/leads.db

# Optional Meta cookies for stability (path to a Playwright storageState JSON)
# STORAGE_STATE=./meta-session.json

# ── SERP APIs (owner search) ────────────────────────────────────────────────
# Optional but strongly recommended: scraping search engines hits CAPTCHAs and
# IP throttling, a SERP API does not. Providers are tried in order and each is
# capped per month. With no keys set, owner search falls back to scraping.
#   Serper  https://serper.dev   2,500 free credits on signup (Google index)
#   Tavily  https://tavily.com   1,000 credits/month recurring
SERP_ENABLED=true
SERPER_API_KEY=
TAVILY_API_KEY=
SERP_MAX_PER_MONTH=1000

# Fall back to scraping engines when the APIs return nothing.
OWNER_SCRAPE_FALLBACK=true
