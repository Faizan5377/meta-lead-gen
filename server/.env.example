# Server
PORT=8787

# Scraping — runs HEADLESS by default (the browser never opens).
HEADFUL=false
SLOW_MO_MS=0

# Hard ceiling on advertisers per run. A run returns EXACTLY the target asked
# for, never more; fewer only when the Ad Library genuinely runs out.
MAX_TARGET=2500

# Robustness knobs
MAX_RUN_MS=5400000            # safety ceiling for a whole harvest (90 min)
SCROLL_SETTLE_MS=2200         # pause after every scroll so the next feed page loads
STABLE_SCROLLS_TO_STOP=5      # stop after N scrolls with zero new ads
NO_NEW_ADS_GRACE_MS=7000      # extra wait+recheck before counting a scroll as empty
ENRICH_CONCURRENCY=3          # parallel pages for advertiser-detail enrichment

# ── Niche relevance ─────────────────────────────────────────────────────────
# Meta's keyword search is loose: "plumbing" also returns supplements and
# gadgets. Every ad is scored against the niche and weak ones are dropped BEFORE
# they use up your target. Nothing about any vertical is hardcoded — scoring uses
# your keyword, the ad's text/destination, and Meta's own page categories.
RELEVANCE_ENABLED=true
RELEVANCE_MIN_SCORE=40

# ── Supabase (shared ad library) ────────────────────────────────────────────
# Cross-run dedup lives here, so repeat searches only return NEW advertisers.
# Without credentials the app falls back to the local SQLite library.
SUPABASE_ENABLED=true
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Only needed by `npm run supabase:setup`, which runs DDL over a real
# Postgres connection. Not used at runtime.
SUPABASE_DB_PASSWORD=

# Local fallback library (SQLite).
# DB_PATH=./data/leads.db

# Optional Meta cookies for stability (path to a Playwright storageState JSON)
# STORAGE_STATE=./meta-session.json
