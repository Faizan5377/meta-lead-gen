# Server
PORT=8787

# Playwright
HEADFUL=true                 # show the browser while scraping (recommended for first runs)
SLOW_MO_MS=0                 # extra slow-mo per action (Playwright slowMo)
MAX_CARDS_PER_KEYWORD=200     # default cap; overridable per-search from the UI (100/200/500)
MAX_SCROLL_MS=180000          # 3 minutes hard ceiling per keyword
STABLE_SCROLLS_TO_STOP=2      # exit after N scrolls that yield no new ads (each waits the grace below)
SCROLL_SETTLE_MS=2500         # pause after EVERY scroll so lazy-loaded ads can render
NO_NEW_ADS_GRACE_MS=8000      # if a scroll shows no new ads, wait this long and re-check before giving up
ENRICH_CONCURRENCY=2          # parallel "See ad details" drawers

# Optional Meta cookies for stability (path to a Playwright storageState JSON)
# STORAGE_STATE=./meta-session.json
