# Server
PORT=8787

# Scraping — runs HEADLESS by default (the browser never opens). Set HEADFUL=true
# only to watch/debug a run locally.
HEADFUL=false
SLOW_MO_MS=0

# Harvest target — the scraper keeps going until it collects this many unique
# businesses OR genuinely runs out of ads while scrolling.
TARGET_ADS=5000

# Robustness knobs
MAX_RUN_MS=2700000            # safety ceiling for a whole harvest (45 min)
SCROLL_SETTLE_MS=2200         # pause after every scroll so the next feed page loads
STABLE_SCROLLS_TO_STOP=5      # stop after N scrolls with zero new ads (feed exhausted)
NO_NEW_ADS_GRACE_MS=7000      # extra wait+recheck before counting a scroll as empty
ENRICH_CONCURRENCY=3          # parallel pages for contact / owner enrichment

# Automatic Google owner-enrichment phase (best-effort). Set to false to skip it.
GOOGLE_ENRICH=true

# Local database (SQLite). Stores every seen ad + kept business so re-searches
# skip what you already have.
# DB_PATH=./data/leads.db

# Optional Meta cookies for stability (path to a Playwright storageState JSON)
# STORAGE_STATE=./meta-session.json
